[
  {
    "id": "tab.solar",
    "type": "tab",
    "label": "Solar Load Controller",
    "disabled": false,
    "info": "Subscribes telemetry/esp32, logs to file, drives dashboard gauges/chart, and provides a mode switch publishing cmd/esp32."
  },
  {
    "id": "mqtt.broker.local",
    "type": "mqtt-broker",
    "name": "local mosquitto",
    "broker": "localhost",
    "port": "1883",
    "clientid": "node-red-solar",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "ui.tab.dash",
    "type": "ui_tab",
    "name": "Solar",
    "icon": "dashboard",
    "order": 1
  },
  {
    "id": "ui.group.power",
    "type": "ui_group",
    "name": "Power",
    "tab": "ui.tab.dash",
    "order": 1,
    "disp": true,
    "width": "6"
  },
  {
    "id": "ui.group.state",
    "type": "ui_group",
    "name": "Appliances",
    "tab": "ui.tab.dash",
    "order": 2,
    "disp": true,
    "width": "6"
  },
  {
    "id": "ui.group.control",
    "type": "ui_group",
    "name": "Control",
    "tab": "ui.tab.dash",
    "order": 3,
    "disp": true,
    "width": "6"
  },

  {
    "id": "mqtt.in.telemetry",
    "type": "mqtt in",
    "z": "tab.solar",
    "name": "telemetry/esp32",
    "topic": "telemetry/esp32",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt.broker.local",
    "x": 160,
    "y": 80,
    "wires": [["fn.split", "file.log", "dbg.tel"]]
  },
  {
    "id": "dbg.tel",
    "type": "debug",
    "z": "tab.solar",
    "name": "telemetry",
    "active": true,
    "console": false,
    "complete": "payload",
    "x": 400,
    "y": 40,
    "wires": []
  },
  {
    "id": "file.log",
    "type": "file",
    "z": "tab.solar",
    "name": "append telemetry.log",
    "filename": "/data/telemetry.log",
    "appendNewline": true,
    "createDir": true,
    "overwriteFile": "false",
    "x": 430,
    "y": 80,
    "wires": [[]]
  },
  {
    "id": "fn.split",
    "type": "function",
    "z": "tab.solar",
    "name": "fan out fields",
    "func": "const p = msg.payload || {};\nconst now = p.ts || Date.now();\nreturn [\n  { topic: 'input_w',     payload: p.input_w     ?? 0 },\n  { topic: 'usage_w',     payload: p.usage_w     ?? 0 },\n  { topic: 'available_w', payload: p.available_w ?? 0 },\n  { topic: 'mode',        payload: p.mode        ?? '-' },\n  { topic: 'ac',          payload: (p.ac && p.ac.observed)  || '-' },\n  { topic: 'fan',         payload: (p.fan && p.fan.observed) || '-' },\n  { topic: 'chart', payload: [\n    { series: ['input_w','usage_w','available_w'],\n      data:   [ [{x: now, y: p.input_w ?? 0}], [{x: now, y: p.usage_w ?? 0}], [{x: now, y: p.available_w ?? 0}] ],\n      labels: [''] }\n  ] }\n];",
    "outputs": 7,
    "x": 410,
    "y": 160,
    "wires": [
      ["ui.gauge.input"],
      ["ui.gauge.usage"],
      ["ui.gauge.avail"],
      ["ui.text.mode"],
      ["ui.text.ac"],
      ["ui.text.fan"],
      ["ui.chart.power"]
    ]
  },

  {
    "id": "ui.gauge.input",
    "type": "ui_gauge",
    "z": "tab.solar",
    "name": "input_w",
    "group": "ui.group.power",
    "order": 1,
    "label": "input (W)",
    "format": "{{value}}",
    "min": "0",
    "max": "2000",
    "x": 720,
    "y": 100,
    "wires": []
  },
  {
    "id": "ui.gauge.usage",
    "type": "ui_gauge",
    "z": "tab.solar",
    "name": "usage_w",
    "group": "ui.group.power",
    "order": 2,
    "label": "usage (W)",
    "format": "{{value}}",
    "min": "0",
    "max": "2000",
    "x": 720,
    "y": 140,
    "wires": []
  },
  {
    "id": "ui.gauge.avail",
    "type": "ui_gauge",
    "z": "tab.solar",
    "name": "available_w",
    "group": "ui.group.power",
    "order": 3,
    "gtype": "wave",
    "label": "available (W)",
    "format": "{{value}}",
    "min": "-1500",
    "max": "1500",
    "x": 720,
    "y": 180,
    "wires": []
  },
  {
    "id": "ui.text.mode",
    "type": "ui_text",
    "z": "tab.solar",
    "name": "mode",
    "group": "ui.group.state",
    "order": 1,
    "label": "mode",
    "format": "{{msg.payload}}",
    "x": 720,
    "y": 240,
    "wires": []
  },
  {
    "id": "ui.text.ac",
    "type": "ui_text",
    "z": "tab.solar",
    "name": "ac",
    "group": "ui.group.state",
    "order": 2,
    "label": "AC",
    "format": "{{msg.payload}}",
    "x": 720,
    "y": 280,
    "wires": []
  },
  {
    "id": "ui.text.fan",
    "type": "ui_text",
    "z": "tab.solar",
    "name": "fan",
    "group": "ui.group.state",
    "order": 3,
    "label": "Fan",
    "format": "{{msg.payload}}",
    "x": 720,
    "y": 320,
    "wires": []
  },
  {
    "id": "ui.chart.power",
    "type": "ui_chart",
    "z": "tab.solar",
    "name": "power chart",
    "group": "ui.group.power",
    "order": 4,
    "width": "12",
    "height": "5",
    "label": "power (W) over time",
    "chartType": "line",
    "removeOlder": "10",
    "removeOlderUnit": "60",
    "ymin": "-500",
    "ymax": "2000",
    "x": 720,
    "y": 220,
    "wires": [[]]
  },

  {
    "id": "ui.switch.mode",
    "type": "ui_switch",
    "z": "tab.solar",
    "name": "mode switch",
    "group": "ui.group.control",
    "order": 1,
    "label": "auto / manual",
    "topic": "",
    "onvalue": "manual",
    "onvalueType": "str",
    "offvalue": "auto",
    "offvalueType": "str",
    "x": 160,
    "y": 360,
    "wires": [["fn.mode.cmd"]]
  },
  {
    "id": "fn.mode.cmd",
    "type": "function",
    "z": "tab.solar",
    "name": "build cmd/esp32",
    "func": "return { topic: 'cmd/esp32', payload: { mode: msg.payload, ac: null, fan: null } };",
    "outputs": 1,
    "x": 400,
    "y": 360,
    "wires": [["mqtt.out.cmd"]]
  },
  {
    "id": "mqtt.out.cmd",
    "type": "mqtt out",
    "z": "tab.solar",
    "name": "cmd/esp32",
    "topic": "",
    "qos": "1",
    "retain": "false",
    "broker": "mqtt.broker.local",
    "x": 640,
    "y": 360,
    "wires": []
  },

  {
    "id": "fn.alert.override",
    "type": "function",
    "z": "tab.solar",
    "name": "override alert",
    "func": "const p = msg.payload || {};\nif (p.override_until && Date.now() < p.override_until) {\n  const mins = Math.round((p.override_until - Date.now()) / 60000);\n  return { payload: `override active ~${mins} min` };\n}\nreturn null;",
    "outputs": 1,
    "x": 400,
    "y": 440,
    "wires": [["dbg.alert"]]
  },
  {
    "id": "dbg.alert",
    "type": "debug",
    "z": "tab.solar",
    "name": "alert",
    "active": true,
    "complete": "payload",
    "x": 640,
    "y": 440,
    "wires": []
  },
  {
    "id": "link.tel.to.alert",
    "type": "link out",
    "z": "tab.solar",
    "name": "telemetry → alert",
    "links": ["link.alert.in"],
    "x": 240,
    "y": 440,
    "wires": []
  },
  {
    "id": "link.alert.in",
    "type": "link in",
    "z": "tab.solar",
    "name": "",
    "links": ["link.tel.to.alert"],
    "x": 320,
    "y": 440,
    "wires": [["fn.alert.override"]]
  }
]
