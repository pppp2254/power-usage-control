MQTT_URL=mqtt://localhost:1883
HTTP_PORT=3000
# Optional MQTT auth (for FlowFuse broker)
# MQTT_USERNAME=
# MQTT_PASSWORD=
# Comma-separated origins allowed to open the /ws bridge.
# Defaults to http://localhost:$HTTP_PORT and the 127.0.0.1 form.
# ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.50:3000
